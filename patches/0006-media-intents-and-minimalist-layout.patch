+import com.atharok.btremote.R
+import com.atharok.btremote.domain.entities.settings.MinimalistButton
+import com.atharok.btremote.domain.entities.settings.MinimalistLayout
+import com.atharok.btremote.domain.entities.settings.RemoteSettings
+import com.atharok.btremote.presentation.viewmodel.SettingsViewModel
+import com.atharok.btremote.ui.components.AppScaffold
+import com.atharok.btremote.ui.components.ListDialog
+import com.atharok.btremote.ui.components.NavigateUpIconButton
+import com.atharok.btremote.ui.views.remote.MinimalistButtonGrid
+import com.atharok.btremote.ui.views.remote.icon
+import com.atharok.btremote.ui.views.remote.label
+import java.io.IOException
+import kotlinx.coroutines.launch
+import org.koin.androidx.compose.koinViewModel
+
+@Composable
+fun MinimalistLayoutScreen(
+    navigateUp: () -> Unit,
+    settingsViewModel: SettingsViewModel = koinViewModel()
+) {
+    val settings by settingsViewModel.remoteSettingsFlow.collectAsStateWithLifecycle(
+        initialValue = null as RemoteSettings?
+    )
+    val scope = rememberCoroutineScope()
+    var draft by rememberSaveable { mutableStateOf<String?>(null) }
+    var selection by rememberSaveable { mutableStateOf<Int?>(null) }
+    var pickingButton by rememberSaveable { mutableStateOf(false) }
+    var saving by remember { mutableStateOf(false) }
+    var saveFailed by rememberSaveable { mutableStateOf(false) }
+
+    val storedLayout = settings?.minimalistLayout
+    val layout = draft?.let { MinimalistLayout.decode(it) } ?: storedLayout
+
+    AppScaffold(
+        title = stringResource(R.string.customize_minimalist_remote),
+        navigateUp = { NavigateUpIconButton(navigateUp) },
+        topBarActions = {
+            TextButton(
+                enabled = !saving && layout != null && storedLayout != null && layout != storedLayout,
+                onClick = {
+                    val updatedLayout = layout ?: return@TextButton
+                    saving = true
+                    saveFailed = false
+                    scope.launch {
+                        try {
+                            settingsViewModel.saveMinimalistLayout(updatedLayout)
+                            navigateUp()
+                        } catch (_: IOException) {
+                            saveFailed = true
+                        } finally {
+                            saving = false
+                        }
+                    }
+                }
+            ) {
+                Text(stringResource(R.string.minimalist_save))
+            }
+        }
+    ) { innerPadding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(innerPadding)
+                .verticalScroll(rememberScrollState())
+                .padding(16.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp)
+        ) {
+            if (layout == null) {
+                CircularProgressIndicator()
+                return@Column
+            }
+
+            Text(stringResource(R.string.minimalist_layout_instructions))
+
+            MinimalistButtonGrid(Modifier.height(272.dp)) { index, slotModifier ->
+                val button = layout.buttons[index]
+                val label = button.label()
+                val slotDescription = stringResource(R.string.minimalist_slot_description, index + 1, label)
+                FilterChip(
+                    selected = selection == index,
+                    enabled = !saving,
+                    onClick = {
+                        val previous = selection
+                        when {
+                            previous == index -> selection = null
+                            previous == null -> selection = index
+                            else -> {
+                                draft = layout.swap(previous, index).encode()
+                                selection = null
+                            }
+                        }
+                    },
+                    label = {
+                        Column(
+                            modifier = Modifier.fillMaxWidth(),
+                            horizontalAlignment = Alignment.CenterHorizontally
+                        ) {
+                            button?.icon?.let {
+                                Icon(it, contentDescription = null, modifier = Modifier.size(20.dp))
+                            }
+                            Text(
+                                text = label,
+                                style = MaterialTheme.typography.labelSmall,
+                                textAlign = TextAlign.Center,
+                                maxLines = 2
+                            )
+                        }
+                    },
+                    modifier = slotModifier.semantics { contentDescription = slotDescription }
+                )
+            }
+
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.SpaceBetween
+            ) {
+                Button(
+                    enabled = selection != null && !saving,
+                    onClick = { pickingButton = true }
+                ) {
+                    Text(stringResource(R.string.minimalist_choose_button))
+                }
+                TextButton(
+                    enabled = !saving && layout != MinimalistLayout.Default,
+                    onClick = {
+                        draft = MinimalistLayout.Default.encode()
+                        selection = null
+                    }
+                ) {
+                    Text(stringResource(R.string.minimalist_reset))
+                }
+            }
+
+            if (saveFailed) {
+                Text(
+                    text = stringResource(R.string.minimalist_save_failed),
+                    color = MaterialTheme.colorScheme.error
+                )
+            }
+        }
+    }
+
+    val selectedSlot = selection
+    if (pickingButton && selectedSlot != null && layout != null) {
+        val choices = listOf(null) + MinimalistButton.entries
+        ListDialog(
+            confirmButtonText = stringResource(R.string.done),
+            dismissButtonText = stringResource(R.string.close),
+            onConfirmation = { index ->
+                draft = layout.replace(selectedSlot, choices[index]).encode()
+                pickingButton = false
+                selection = null
+            },
+            onDismissRequest = { pickingButton = false },
+            dialogTitle = stringResource(R.string.minimalist_choose_button),
+            items = choices.map { it.label() },
+            defaultItemIndex = choices.indexOf(layout.buttons[selectedSlot])
+        )
+    }
+}
