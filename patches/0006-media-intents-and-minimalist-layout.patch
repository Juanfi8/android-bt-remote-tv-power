+package com.atharok.btremote.domain.entities.settings
+
+import com.atharok.btremote.domain.entities.remoteInput.ChannelButtonProperties
+import com.atharok.btremote.domain.entities.remoteInput.RemoteButtonProperties
+import com.atharok.btremote.domain.entities.settings.MinimalistButton.*
+
+enum class MinimalistButton(
+    val remote: RemoteButtonProperties? = null,
+    val channel: ChannelButtonProperties? = null
+) {
+    REWIND(RemoteButtonProperties.RewindButton),
+    PLAY_PAUSE(RemoteButtonProperties.PlayPauseButton),
+    FAST_FORWARD(RemoteButtonProperties.ForwardButton),
+    PREVIOUS_TRACK(RemoteButtonProperties.PreviousTrackButton),
+    NEXT_TRACK(RemoteButtonProperties.NextTrackButton),
+    PLAY(RemoteButtonProperties.PlayButton),
+    PAUSE(RemoteButtonProperties.PauseButton),
+    STOP(RemoteButtonProperties.StopButton),
+    REPEAT(RemoteButtonProperties.RepeatButton),
+    VOLUME_UP(RemoteButtonProperties.VolumeUpButton),
+    VOLUME_DOWN(RemoteButtonProperties.VolumeDownButton),
+    MUTE(RemoteButtonProperties.VolumeMuteButton),
+    CLOSED_CAPTIONS(RemoteButtonProperties.ClosedCaptionsButton),
+    BRIGHTNESS_UP(RemoteButtonProperties.BrightnessUpButton),
+    BRIGHTNESS_DOWN(RemoteButtonProperties.BrightnessDownButton),
+    CHANNEL_UP(RemoteButtonProperties.ChannelUpButton),
+    CHANNEL_DOWN(RemoteButtonProperties.ChannelDownButton),
+    CHANNELS,
+    MORE,
+    BACK(RemoteButtonProperties.BackButton),
+    HOME(RemoteButtonProperties.HomeButton),
+    MENU(RemoteButtonProperties.MenuButton),
+    POWER(RemoteButtonProperties.PowerButton),
+    UP(RemoteButtonProperties.MenuUpButton),
+    DOWN(RemoteButtonProperties.MenuDownButton),
+    LEFT(RemoteButtonProperties.MenuLeftButton),
+    RIGHT(RemoteButtonProperties.MenuRightButton),
+    SELECT(RemoteButtonProperties.MenuPickButton),
+    RED(RemoteButtonProperties.RedMenuButton),
+    GREEN(RemoteButtonProperties.GreenMenuButton),
+    BLUE(RemoteButtonProperties.BlueMenuButton),
+    YELLOW(RemoteButtonProperties.YellowMenuButton),
+    DIGIT_0(channel = ChannelButtonProperties.Channel0Button),
+    DIGIT_1(channel = ChannelButtonProperties.Channel1Button),
+    DIGIT_2(channel = ChannelButtonProperties.Channel2Button),
+    DIGIT_3(channel = ChannelButtonProperties.Channel3Button),
+    DIGIT_4(channel = ChannelButtonProperties.Channel4Button),
+    DIGIT_5(channel = ChannelButtonProperties.Channel5Button),
+    DIGIT_6(channel = ChannelButtonProperties.Channel6Button),
+    DIGIT_7(channel = ChannelButtonProperties.Channel7Button),
+    DIGIT_8(channel = ChannelButtonProperties.Channel8Button),
+    DIGIT_9(channel = ChannelButtonProperties.Channel9Button)
+}
+
+@JvmInline
+value class MinimalistLayout private constructor(val buttons: List<MinimalistButton?>) {
+    fun replace(index: Int, button: MinimalistButton?): MinimalistLayout =
+        MinimalistLayout(buttons.toMutableList().apply { this[index] = button })
+
+    fun swap(first: Int, second: Int): MinimalistLayout =
+        replace(first, buttons[second]).replace(second, buttons[first])
+
+    fun encode(): String = buttons.joinToString(",") { it?.name.orEmpty() }
+
+    companion object {
+        val slotRows = listOf(0..2, 3..6, 7..10, 11..14)
+        private val slotCount = slotRows.last().last + 1
+        private val buttonsByName = MinimalistButton.entries.associateBy { it.name }
+
+        val Default = MinimalistLayout(listOf(
+            REWIND, PLAY_PAUSE, FAST_FORWARD,
+            VOLUME_UP, MUTE, CLOSED_CAPTIONS, BRIGHTNESS_UP,
+            VOLUME_DOWN, CHANNELS, MORE, BRIGHTNESS_DOWN,
+            BACK, HOME, MENU, POWER
+        ))
+
+        fun decode(encoded: String?): MinimalistLayout {
+            val slots = encoded?.split(',') ?: return Default
+            if (slots.size != slotCount) return Default
+            return MinimalistLayout(slots.map { buttonsByName[it] })
+        }
+    }
+}
