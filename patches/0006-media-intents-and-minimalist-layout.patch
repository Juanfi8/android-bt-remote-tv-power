+package com.atharok.btremote.ui.views.remote
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxHeight
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.shape.CircleShape
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.key
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.vector.ImageVector
+import androidx.compose.ui.res.dimensionResource
+import androidx.compose.ui.res.stringResource
+import com.atharok.btremote.R
+import com.atharok.btremote.common.utils.AppIcons
+import com.atharok.btremote.domain.entities.settings.MinimalistButton
+import com.atharok.btremote.domain.entities.settings.MinimalistLayout
+import com.atharok.btremote.ui.components.customButtons.ChannelSurfaceButton
+import com.atharok.btremote.ui.components.customButtons.IconSurfaceButton
+import com.atharok.btremote.ui.components.customButtons.RemoteIconSurfaceButton
+
+@Composable
+internal fun MinimalistRemoteView(
+    layout: MinimalistLayout,
+    sendRemoteKeyReport: (ByteArray) -> Unit,
+    sendKeyboardKeyReport: (ByteArray) -> Unit,
+    onTVChannelButtonsChanged: () -> Unit,
+    onMoreButtonsVisibleChanged: () -> Unit,
+    modifier: Modifier = Modifier
+) {
+    MinimalistButtonGrid(modifier) { index, slotModifier ->
+        val button = layout.buttons[index]
+        val remote = button?.remote
+        val channel = button?.channel
+        key(button) {
+            when {
+                remote != null -> RemoteIconSurfaceButton(
+                    properties = remote,
+                    sendKeyReport = sendRemoteKeyReport,
+                    modifier = slotModifier,
+                    shape = CircleShape
+                )
+
+                channel != null -> ChannelSurfaceButton(
+                    properties = channel,
+                    sendKeyReport = sendKeyboardKeyReport,
+                    modifier = slotModifier,
+                    shape = CircleShape
+                )
+
+                button == MinimalistButton.CHANNELS || button == MinimalistButton.MORE -> IconSurfaceButton(
+                    image = checkNotNull(button.icon),
+                    contentDescription = button.label(),
+                    touchDown = {},
+                    touchUp = if (button == MinimalistButton.CHANNELS) {
+                        onTVChannelButtonsChanged
+                    } else {
+                        onMoreButtonsVisibleChanged
+                    },
+                    modifier = slotModifier,
+                    shape = CircleShape
+                )
+
+                else -> Box(slotModifier)
+            }
+        }
+    }
+}
+
+@Composable
+internal fun MinimalistButtonGrid(
+    modifier: Modifier = Modifier,
+    content: @Composable (index: Int, modifier: Modifier) -> Unit
+) {
+    val padding = dimensionResource(R.dimen.padding_normal)
+    Column(modifier = modifier.fillMaxSize()) {
+        MinimalistLayout.slotRows.forEach { row ->
+            Row(
+                modifier = Modifier.fillMaxWidth().weight(1f),
+                horizontalArrangement = Arrangement.Center
+            ) {
+                row.forEach { index ->
+                    content(index, Modifier.weight(1f).fillMaxHeight().padding(padding))
+                }
+            }
+        }
+    }
+}
+
+internal val MinimalistButton.icon: ImageVector?
+    get() = when (this) {
+        MinimalistButton.CHANNELS -> AppIcons.TVChannel
+        MinimalistButton.MORE -> AppIcons.MoreHoriz
+        else -> remote?.icon
+    }
+
+@Composable
+internal fun MinimalistButton?.label(): String {
+    val labelRes = when (this) {
+        null -> R.string.minimalist_empty_slot
+        MinimalistButton.CHANNELS -> R.string.tv
+        MinimalistButton.MORE -> R.string.more_buttons
+        else -> remote?.stringRes
+    }
+    return labelRes?.let { stringResource(it) } ?: checkNotNull(this?.channel).text
+}
