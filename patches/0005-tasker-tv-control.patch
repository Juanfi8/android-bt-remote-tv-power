+package com.atharok.btremote.presentation.services
+
+import android.bluetooth.BluetoothProfile.STATE_CONNECTED
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import com.atharok.btremote.domain.entities.remoteInput.RemoteButtonProperties
+import com.atharok.btremote.domain.usecases.BluetoothHidServiceUseCase
+
+internal class TaskerCommandReceiver(
+    private val useCase: BluetoothHidServiceUseCase
+) : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != ACTION_TV_COMMAND || intent.`package` != context.packageName) return
+        if (useCase.getDeviceHidConnectionState().value.state != STATE_CONNECTED) return
+
+        val button = when (intent.getStringExtra(EXTRA_COMMAND)) {
+            "left" -> RemoteButtonProperties.MenuLeftButton
+            "right" -> RemoteButtonProperties.MenuRightButton
+            "up" -> RemoteButtonProperties.MenuUpButton
+            "down" -> RemoteButtonProperties.MenuDownButton
+            "volume_up" -> RemoteButtonProperties.VolumeUpButton
+            "volume_down" -> RemoteButtonProperties.VolumeDownButton
+            "enter" -> RemoteButtonProperties.MenuPickButton
+            "home" -> RemoteButtonProperties.HomeButton
+            "back" -> RemoteButtonProperties.BackButton
+            "power" -> RemoteButtonProperties.PowerButton
+            else -> return
+        }
+        useCase.tapRemoteButton(button)
+    }
+
+    companion object {
+        const val ACTION_TV_COMMAND = "io.github.jqssun.btremote.action.TV_COMMAND"
+        private const val EXTRA_COMMAND = "command"
+    }
+}
